# Base44 dev image: installs the jrnl project's dependencies (Poetry) so the
# mkdocs documentation site can be served AND the jrnl CLI is runnable.
# Source is bind-mounted at runtime (see docker-compose.base44.yml), so edits
# are reflected live without rebuilding this image.
FROM python:3.12-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
        build-essential \
        libffi-dev \
    && rm -rf /var/lib/apt/lists/*

RUN pip install --no-cache-dir poetry

WORKDIR /app

# Install dependencies only (not the project root) so the image stays valid
# across source changes. Source arrives via the bind mount at runtime.
COPY pyproject.toml poetry.lock ./
RUN poetry config virtualenvs.create false && poetry install --no-root

EXPOSE 3000

# Serve the mkdocs documentation site on port 3000 with live reload.
CMD ["mkdocs", "serve", "--dev-addr", "0.0.0.0:3000"]
